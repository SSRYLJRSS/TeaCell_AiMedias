{
  "schemaVersion": 1,
  "maxRequestBytes": 65536,
  "maxResponseBytes": 65536,
  "maxPageItems": 100,
  "maxWorkflowSteps": 8,
  "maxWorkflowParameters": 7,
  "fieldRules": {
    "LoadWorkflowInput":{"version":{"minimum":1}},
    "PrepareWorkflowInput":{"version":{"minimum":1}},
    "WorkflowSummary":{"version":{"minimum":1}},
    "WorkflowPlanPreview":{"version":{"minimum":1}}
  },
  "scalars": {
    "ResourceRef":{"minBytes":16,"maxBytes":128,"asciiToken":true},
    "ShortText":{"maxBytes":256,"rejectNul":true},
    "Instructions":{"maxBytes":4096,"rejectNul":true}
  },
  "errorMessages": {
    "INVALID_INPUT":"请求格式或大小不符合要求，请修改后重试。",
    "UNSUPPORTED_PROTOCOL":"请求协议版本不受支持，请更新调用方。",
    "UNSUPPORTED_CAPABILITY":"当前版本不支持此操作。",
    "UNSUPPORTED_PLATFORM":"当前平台不支持此操作。",
    "UNAUTHORIZED":"没有访问此资源的权限，请通过可信界面授权。",
    "GRANT_REVOKED":"资源授权已撤销，请重新授权。",
    "REFERENCE_EXPIRED":"资源引用已失效，请重新选择。",
    "LIBRARY_CHANGED":"总仓状态已改变，请重新准备计划。",
    "LIBRARY_OFFLINE":"总仓当前不可用，请检查总仓位置。",
    "OWNERSHIP_UNVERIFIED":"文件归属尚未核验，请先处理待核验记录。",
    "APPROVAL_REQUIRED":"此操作需要对应计划的明确确认。",
    "PLAN_EXPIRED":"计划已过期，请重新准备并确认。",
    "PLAN_CHANGED":"计划范围或配置已改变，请重新审核。",
    "IDEMPOTENCY_CONFLICT":"同一提交标识已用于另一计划，请检查原操作。",
    "RESOURCE_CONFLICT":"资源正在使用或目标发生冲突，请检查后重试。",
    "MAINTENANCE_ACTIVE":"总仓维护正在进行，请稍后重试。",
    "SERVICE_UNAVAILABLE":"服务暂时不可用，请选择重试或其他服务。",
    "BUDGET_EXCEEDED":"任务已达到批准的预算上限，请重新审核预算。",
    "OUTCOME_UNKNOWN":"部分操作结果需要核实，请查看恢复摘要。",
    "CANCELLED":"操作已取消，已经完成的结果仍予保留。",
    "INTERNAL":"操作未能完成，请查看诊断信息后重试。"
  },
  "evaluationAdapterVersion": 1,
  "evaluationCases": {
    "E01":{"caseVersion":1,"prototypeCapability":"imports.preview","capability":"imports.prepare","expectedErrors":[]},
    "E02":{"caseVersion":1,"prototypeCapability":"imports.submit","capability":"imports.submit","expectedErrors":[]},
    "E03":{"caseVersion":1,"prototypeCapability":"imports.submit","capability":"imports.submit","expectedErrors":["INVALID_INPUT","APPROVAL_REQUIRED"]},
    "E04":{"caseVersion":1,"prototypeCapability":"imports.prepare","capability":"imports.prepare","expectedErrors":["UNAUTHORIZED"]},
    "E05":{"caseVersion":1,"prototypeCapability":"imports.submit","capability":"imports.submit","expectedErrors":[]},
    "E06":{"caseVersion":1,"prototypeCapability":"operations.resume","capability":"operations.resume","expectedErrors":[]},
    "E07":{"caseVersion":1,"prototypeCapability":"imports.submit","capability":"imports.submit","expectedErrors":["INVALID_INPUT","APPROVAL_REQUIRED","UNAUTHORIZED"]},
    "E08":{"caseVersion":1,"prototypeCapability":"trash.empty.policy-only","capability":"trash.empty.submit","expectedErrors":["APPROVAL_REQUIRED"]}
