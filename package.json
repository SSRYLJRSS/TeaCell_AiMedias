{
  "name": "teacell-ai-media-manager",
  "private": true,
  "version": "1.0.2",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:tooling": "node --test scripts/a6-packaging-budget.test.mjs scripts/acceptance-evidence.test.mjs scripts/agent-contract.test.mjs scripts/agent-evals-coverage.test.mjs scripts/build-cache.test.mjs scripts/build-environment.test.mjs scripts/candidate-contract.test.mjs scripts/heif-contract.test.mjs scripts/verify-candidates.test.mjs scripts/windows-vc-runtime.test.mjs",
    "test:acceptance": "node scripts/acceptance-evidence.mjs check",
    "test:evals": "node scripts/agent-evals-coverage.mjs check && node scripts/agent-evals-runner.mjs",
    "test:evals:runner": "node scripts/agent-evals-runner.mjs",
    "test:packaging-budget": "node scripts/a6-packaging-budget.mjs check",
    "test:agent-performance": "cd src-tauri && cargo test --all-features --test a6_agent_performance -- --test-threads=1",
    "build:cache:status": "node scripts/build-cache.mjs status",
    "build:cache:clean": "node scripts/build-cache.mjs clean",
    "test:agent-host": "npm --prefix packages/agent-host test",
    "test:agent-host-staged": "node scripts/probe-agent-host-stage.mjs",
    "test:mcp-bridge": "npm --prefix packages/mcp-bridge test",
    "test:mcp-interop": "npm --prefix packages/mcp-interop test",
    "tauri": "tauri",
    "test:ignored": "cd src-tauri && cargo test --test perf_probe -- --ignored",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:check": "node scripts/desktop.mjs check",
    "desktop:check:strict": "node scripts/desktop.mjs check --strict-release",
    "prepare-media-tools": "node scripts/prepare-media-tools.mjs",
    "prepare-agent-host": "node scripts/prepare-agent-host.mjs",
    "prepare-heif-libraries": "node scripts/prepare-heif-libraries.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "clsx": "^2.1.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.34.0",
    "mermaid": "^12.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.70.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
