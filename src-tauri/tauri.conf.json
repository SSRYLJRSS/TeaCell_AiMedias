{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeaCell AI Media Manager",
  "version": "1.0.2",
  "identifier": "com.bagertea.aimdeias",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "茶馆",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TeaCell",
    "homepage": "https://github.com/SSRYLJRSS/TeaCell_AiMedias",
    "copyright": "Copyright © 2026 TeaCell contributors",
    "license": "GPL-3.0-or-later",
    "shortDescription": "茶馆AI素材管理 / TeaCell AI Media Manager",
    "longDescription": "本地优先的图片与视频素材管理应用，支持人工确认的 AI 打标、组合筛选与超级搜索。 / A local-first photo and video asset manager with human-approved AI tagging, combined filters, and advanced search.",
    "windows": {
      "wix": {
        "upgradeCode": "30bc1910-3467-5659-bcff-284af99c9896",
        "language": {
          "en-US": {
            "localePath": "wix/en-us.wxl"
          },
          "zh-CN": {
            "localePath": "wix/zh-cn.wxl"
          }
        }
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
